load("@rules_go//go:def.bzl", "go_binary")

# The plugin proof: bazel run //ci/proof -- [--newest | --source] WORK_DIR
# (docs/proof.md).
go_binary(
    name = "proof",
    args = [
        "--go=$(rlocationpath @go_sdk//:bin/go)",
        "run",
        "./ci/proof",
    ],
    data = [
        "@go_sdk//:bin/go",
        "@go_sdk//:files",
    ],
    embed = ["//ci/launch:lib"],
)

# The program's own files, without this BUILD file: the slices that run
# the program with go take them.
filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "files",
    srcs = glob(["**"]),
    visibility = ["//ci:__pkg__"],
)
