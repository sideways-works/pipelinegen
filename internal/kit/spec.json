{
  "pipeline": "fixture",
  "github": {
    "repository": "owner/fixture",
    "token_var": "github_token",
    "status_prefix": "pipelinegen"
  },
  "ci": {
    "branch": "main",
    "include": "",
    "planner": {
      "bootstrap": {
        "bazelisk": {
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "version": "v1.27.0"
        },
        "commit": "0123456789abcdef0123456789abcdef01234567",
        "release": null,
        "repository": "sideways-works/pipelinegen"
      },
      "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "image": {
        "repository": "golang",
        "tag": "1.27.1"
      },
      "prepare": ""
    },
    "pull_requests": {},
    "repository": {
      "password": "((github_token))",
      "uri": "https://github.com/owner/fixture.git"
    },
    "self_set": false,
    "team": "fixture",
    "url": "https://ci.example"
  },
  "runs": [
    {
      "name": "main",
      "trigger": {
        "kind": "branch",
        "branch": "main"
      },
      "suites": [
        {
          "suite": "backend",
          "records": false,
          "minutes": 120,
          "minutes_key": "suites.backend.minutes"
        },
        {
          "suite": "e2e",
          "params": {
            "PROJECTS": "phone"
          },
          "records": true,
          "minutes": 120,
          "minutes_key": "suites.e2e.minutes",
          "secrets": {
            "prepare": {
              "NPM_TOKEN": "npm_token"
            }
          }
        }
      ]
    },
    {
      "name": "nightly",
      "trigger": {
        "kind": "timer",
        "branch": "main",
        "timer": {
          "start": "3:00",
          "stop": "4:00",
          "location": "Europe/Berlin"
        }
      },
      "suites": [
        {
          "suite": "backend",
          "records": false,
          "minutes": 120,
          "minutes_key": "suites.backend.minutes"
        },
        {
          "suite": "e2e",
          "params": {
            "PROJECTS": "all"
          },
          "records": true,
          "minutes": 120,
          "minutes_key": "suites.e2e.minutes",
          "secrets": {
            "prepare": {
              "NPM_TOKEN": "npm_token"
            }
          }
        }
      ]
    },
    {
      "name": "pr",
      "trigger": {
        "kind": "pull_requests",
        "base": "main",
        "draft": false,
        "labels_without": [
          "batch"
        ]
      },
      "suites": [
        {
          "suite": "backend",
          "records": false,
          "minutes": 120,
          "minutes_key": "suites.backend.minutes"
        },
        {
          "suite": "e2e",
          "params": {
            "PROJECTS": "phone"
          },
          "records": true,
          "minutes": 120,
          "minutes_key": "suites.e2e.minutes",
          "secrets": {
            "prepare": {
              "NPM_TOKEN": "npm_token"
            }
          }
        }
      ]
    }
  ],
  "suites": [
    {
      "name": "backend",
      "run_slice": "ci/backend-slice.yml",
      "parallel": 2
    },
    {
      "name": "e2e",
      "prepare": "ci/e2e-prepare.yml",
      "run_slice": "ci/e2e-slice.yml",
      "parallel": 4,
      "whole_suite": [
        {
          "name": "reconcile",
          "task": "ci/reconcile.yml"
        }
      ]
    },
    {
      "name": "specs",
      "run_slice": "ci/e2e-slice.yml",
      "parallel": 4
    }
  ],
  "tools": [
    {
      "name": "pipelinegen",
      "kind": "pipelinegen",
      "repository": "sideways-works/pipelinegen",
      "commit": "0123456789abcdef0123456789abcdef01234567"
    },
    {
      "name": "bazelisk",
      "kind": "bazelisk",
      "version": "v1.27.0",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "name": "go-sbom",
      "kind": "sbom",
      "repository": "owner/go-sbom",
      "commit": "0123456789abcdef0123456789abcdef01234567"
    },
    {
      "name": "go-correlator",
      "kind": "correlator",
      "repository": "owner/go-correlator",
      "commit": "0123456789abcdef0123456789abcdef01234567"
    }
  ],
  "config_files": [
    "pipelinegen.yaml"
  ],
  "branch": "main",
  "trusted": "{\"ssh_key\":{\"read\":\"\",\"store\":\"\"},\"github_repository\":\"owner/fixture\",\"github_token\":\"github_token\",\"github_tokens\":{\"read\":\"\",\"changes\":\"\",\"report\":\"\",\"store\":\"\"},\"github_status_prefix\":\"pipelinegen\",\"bazel_diff\":{\"version\":\"\",\"sha256\":null,\"url\":\"\"},\"bazel_bazelisk\":\"bazelisk\",\"plugins\":[{\"name\":\"go-correlator\",\"repository\":\"owner/go-correlator\",\"commit\":\"0123456789abcdef0123456789abcdef01234567\"},{\"name\":\"go-sbom\",\"repository\":\"owner/go-sbom\",\"commit\":\"0123456789abcdef0123456789abcdef01234567\"}],\"concourse_planner_bootstrap\":{\"repository\":\"sideways-works/pipelinegen\",\"release\":null,\"commit\":\"0123456789abcdef0123456789abcdef01234567\",\"bazelisk\":{\"version\":\"v1.27.0\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}},\"locks\":{\"suites\":{}},\"concourse_branch\":\"main\",\"run_suites\":{\"main\":[\"backend\",\"e2e\"],\"nightly\":[\"backend\",\"e2e\"],\"pr\":[\"backend\",\"e2e\"]}}",
  "limits": {
    "plan": 120,
    "steps": 20,
    "lock_wait": 240
  }
}
